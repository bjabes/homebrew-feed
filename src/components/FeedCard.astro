---
import type { FeedItem } from "../lib/feed/types";

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
---

<article class="feed-card">
  <div class="feed-card__meta">
    <span class={`chip chip--${item.kind}`}>{item.kind}</span>
    <span class={`chip chip--${item.changeType}`}>{item.changeType}</span>
    <span class="feed-card__date">{item.date}</span>
  </div>
  <div class="feed-card__body">
    <h3>
      <a href={item.packageUrl}>{item.name}</a>
    </h3>
    <p class="feed-card__token">{item.token}</p>
    <p class="feed-card__version">
      {item.previousVersion ?? "new"} → {item.currentVersion}
    </p>
  </div>
</article>
