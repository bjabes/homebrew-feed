---
import FeedCard from "./FeedCard.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
  createFeedBrowserModel,
  formatFeedDate,
  renderEmptyStateMarkup,
  renderResultsSummary
} from "../lib/feed/browser";
import type { FeedData, FeedMeta, FeedWindow } from "../lib/feed/types";

interface Props {
  feedData: FeedData;
  metaData?: FeedMeta;
}

function serializeJsonForScript(value: unknown): string {
  return JSON.stringify(value)
    .replaceAll("<", "\\u003c")
    .replaceAll("\u2028", "\\u2028")
    .replaceAll("\u2029", "\\u2029");
}

const { feedData, metaData } = Astro.props;
const defaultModel = createFeedBrowserModel(feedData, {
  search: "",
  metaData
});
const serializedFeedData = serializeJsonForScript(feedData);
const serializedMetaData = serializeJsonForScript(metaData ?? null);
const windowLabels: Record<FeedWindow, string> = {
  today: "Today",
  last7: "Last 7 Days",
  previous7: "Previous 7 Days",
  month: "This Month"
};
---

<SiteLayout title="What's New In Homebrew">
  <section class="hero">
    <span class="eyebrow">Homebrew feed</span>
    <h1>What&apos;s New In Homebrew</h1>
    <p class="lede">
      Track the freshest additions and release changes across Homebrew formulae and casks without
      digging through raw JSON or commit logs.
    </p>
    <div class="snapshot-strip">
      <span><strong>Latest snapshot:</strong> {feedData.latestSnapshotDate ?? "No snapshot yet"}</span>
      <span><strong>Published items:</strong> {feedData.items.length}</span>
      {
        defaultModel.viewMeta.trustedSnapshotCount !== null && (
          <span><strong>Snapshots retained:</strong> {defaultModel.viewMeta.trustedSnapshotCount}</span>
        )
      }
    </div>
  </section>

  <section class="feed-shell">
    <div class="controls" data-feed-app>
      <div class="window-pills" data-window-controls>
        {
          (["today", "last7", "previous7", "month"] as const).map((window) => (
            <button
              class={`window-pill ${defaultModel.state.window === window ? "is-active" : ""}`}
              data-window={window}
              type="button"
            >
              {windowLabels[window]} <span>{defaultModel.viewMeta.windowCounts[window]}</span>
            </button>
          ))
        }
      </div>

      <div class="field-row">
        <div class="field">
          <label for="kind-filter">Package type</label>
          <select id="kind-filter" data-type-filter>
            <option value="all">All packages</option>
            <option value="formula">Formulae</option>
            <option value="cask">Casks</option>
          </select>
        </div>
        <div class="field">
          <label for="feed-search">Search</label>
          <input
            id="feed-search"
            data-search-input
            type="search"
            value={defaultModel.state.q}
            placeholder="Search by package name or token"
          />
        </div>
      </div>

      <p class="results-summary" data-results-summary>
        {renderResultsSummary(
          defaultModel.visibleItems.length,
          defaultModel.state.window,
          defaultModel.viewMeta.browseAnchorDate
        )}
      </p>

      <div class="feed-list" data-feed-list>
        {defaultModel.visibleGroups.length > 0 ? (
          defaultModel.visibleGroups.map((group) => (
            <section class="feed-group">
              <h2 class="feed-group__heading">{formatFeedDate(group.date)}</h2>
              <div class="feed-group__items">
                {group.items.map((item) => <FeedCard item={item} />)}
              </div>
            </section>
          ))
        ) : (
          <Fragment set:html={renderEmptyStateMarkup(defaultModel.viewMeta)} />
        )}
      </div>
    </div>
  </section>

  <script type="application/json" id="feed-data" set:html={serializedFeedData}></script>
  <script type="application/json" id="feed-meta" set:html={serializedMetaData}></script>
  <script>
    import "../lib/feed/client";
  </script>
</SiteLayout>
