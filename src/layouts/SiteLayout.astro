---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style is:global>
      :root {
        --paper: #f7f1e6;
        --ink: #18211b;
        --muted: #5f685e;
        --line: rgba(24, 33, 27, 0.14);
        --panel: rgba(255, 251, 244, 0.88);
        --accent: #bf4b2c;
        --accent-soft: rgba(191, 75, 44, 0.14);
        --formula: #2f6f5e;
        --cask: #3556a8;
        --updated: #9d4a15;
        --new: #23663f;
        --shadow: 0 22px 60px rgba(48, 38, 19, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(255, 214, 168, 0.85), transparent 32%),
          linear-gradient(180deg, #fff7eb 0%, #f6ecdb 52%, #efe4d4 100%);
        font-family: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Palatino, Georgia, serif;
      }

      a {
        color: inherit;
      }

      main {
        width: min(1100px, calc(100% - 2rem));
        margin: 0 auto;
        padding: 3rem 0 4rem;
      }

      .hero {
        display: grid;
        gap: 1.4rem;
        margin-bottom: 1.8rem;
        padding: 2.4rem;
        border: 1px solid var(--line);
        border-radius: 28px;
        background: linear-gradient(140deg, rgba(255, 253, 249, 0.95), rgba(250, 236, 214, 0.88));
        box-shadow: var(--shadow);
      }

      .eyebrow {
        display: inline-flex;
        width: fit-content;
        padding: 0.35rem 0.7rem;
        border-radius: 999px;
        background: rgba(24, 33, 27, 0.08);
        color: var(--muted);
        font-size: 0.8rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        max-width: 12ch;
        font-size: clamp(3rem, 9vw, 6rem);
        line-height: 0.92;
        letter-spacing: -0.04em;
      }

      .lede {
        margin: 0;
        max-width: 58ch;
        color: var(--muted);
        font-size: 1.1rem;
        line-height: 1.65;
      }

      .snapshot-strip {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        color: var(--muted);
        font-size: 0.95rem;
      }

      .snapshot-strip strong {
        color: var(--ink);
      }

      .feed-shell {
        display: grid;
        gap: 1rem;
        padding: 1.25rem;
        border: 1px solid var(--line);
        border-radius: 24px;
        background: var(--panel);
        backdrop-filter: blur(14px);
        box-shadow: var(--shadow);
      }

      .controls {
        display: grid;
        gap: 1rem;
      }

      .window-pills {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .window-pill,
      .field select,
      .field input {
        border: 1px solid var(--line);
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.72);
        color: var(--ink);
        font: inherit;
      }

      .window-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 1rem;
        cursor: pointer;
        transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
      }

      .window-pill:hover,
      .window-pill:focus-visible {
        transform: translateY(-1px);
        border-color: rgba(191, 75, 44, 0.35);
      }

      .window-pill.is-active {
        border-color: rgba(191, 75, 44, 0.5);
        background: var(--accent-soft);
      }

      .window-pill span {
        display: inline-flex;
        min-width: 1.8rem;
        justify-content: center;
        padding: 0.12rem 0.42rem;
        border-radius: 999px;
        background: rgba(24, 33, 27, 0.08);
        font-size: 0.85rem;
      }

      .field-row {
        display: grid;
        gap: 1rem;
        grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
      }

      .field {
        display: grid;
        gap: 0.45rem;
      }

      .field label {
        color: var(--muted);
        font-size: 0.88rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .field select,
      .field input {
        width: 100%;
        padding: 0.85rem 1rem;
      }

      .results-summary {
        margin: 0;
        color: var(--muted);
      }

      .feed-list {
        display: grid;
        gap: 0.9rem;
      }

      .feed-card {
        display: grid;
        gap: 0.75rem;
        padding: 1rem 1.05rem;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: rgba(255, 255, 255, 0.74);
      }

      .feed-card__meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        align-items: center;
      }

      .chip {
        display: inline-flex;
        align-items: center;
        padding: 0.28rem 0.65rem;
        border-radius: 999px;
        font-size: 0.8rem;
        text-transform: capitalize;
      }

      .chip--formula {
        background: rgba(47, 111, 94, 0.14);
        color: var(--formula);
      }

      .chip--cask {
        background: rgba(53, 86, 168, 0.14);
        color: var(--cask);
      }

      .chip--updated {
        background: rgba(157, 74, 21, 0.14);
        color: var(--updated);
      }

      .chip--new {
        background: rgba(35, 102, 63, 0.14);
        color: var(--new);
      }

      .feed-card__date,
      .feed-card__token {
        color: var(--muted);
        font-size: 0.92rem;
      }

      .feed-card__body h3 {
        margin: 0;
        font-size: 1.45rem;
      }

      .feed-card__body p {
        margin: 0.2rem 0 0;
      }

      .feed-card__version {
        font-family: "SF Mono", "Monaco", "Cascadia Mono", "Segoe UI Mono", monospace;
        font-size: 0.95rem;
      }

      .empty-state {
        padding: 2rem 1rem;
        border: 1px dashed var(--line);
        border-radius: 18px;
        text-align: center;
        color: var(--muted);
      }

      @media (max-width: 720px) {
        main {
          width: min(100% - 1rem, 100%);
          padding-top: 1rem;
        }

        .hero,
        .feed-shell {
          padding: 1rem;
        }

        .field-row {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
